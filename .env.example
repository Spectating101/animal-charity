AFRN_DB_PATH=/data/relief.db
AFRN_RULEPACK=/code/config/rulepacks/tw_dog_cat_pilot.json
AFRN_MISSION=/code/config/missions/animal_feed_security.json
AFRN_AGENT_INTERVAL_SECONDS=900

# Legacy bounded-pilot bearer token. Keep only when AFRN_ACTOR_REGISTRY is unset.
AFRN_OPERATOR_TOKEN=replace-with-long-random-secret

# Preferred governance-pilot auth. Copy config/access/actors.example.json to
# config/access/actors.local.json, customize actors/roles, and set this path.
# AFRN_ACTOR_REGISTRY=/code/config/access/actors.local.json
# AFRN_TOKEN_ANALYST_1=replace-with-long-random-secret
# AFRN_TOKEN_OPERATOR_1=replace-with-long-random-secret
# AFRN_TOKEN_REVIEWER_1=replace-with-long-random-secret

AFRN_DEMO_MODE=0
